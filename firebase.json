{
  "hosting": {
    "public": "build/web",
    "predeploy": ["flutter build web --release"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}],
    "headers": [
      {
        "source": "/@(index.html|flutter_bootstrap.js|flutter.js|main.dart.js|manifest.json)",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  }
}
