{
  "name": "json-notebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test-*.mjs",
    "build": "ionic build",
    "build:production": "ionic build",
    "android:sync": "ionic build && cap sync android",
    "android": "npm run android:sync && cap open android",
    "build:android": "ionic build && cap sync android && cd android && ./gradlew assembleRelease",
    "ionic:build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.5.11",
    "dompurify": "^3.4.16",
    "firebase": "^12.19.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@ionic/cli": "^7.2.1",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "vite": "^7.1.7"
  }
}
